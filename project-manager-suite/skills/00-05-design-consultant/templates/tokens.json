      "rule": "Use light navigation by default; reserve inverse navigation for dense technical, monitoring or immersive contexts."
    },
    "button": {
      "variants": ["primary", "secondary", "soft", "danger", "text", "icon"],
      "states": ["default", "hover", "focus-visible", "active", "loading", "disabled"],
      "rule": "Buttons and form controls share height, radius, focus and motion tokens."
    },
    "dataTable": {
      "states": ["ready", "loading", "empty", "error"],
      "rule": "Desktop tables may use sticky header; mobile must provide horizontal strategy or record cards."
    },
    "dialog": {
      "requiredBehavior": ["focus trap", "Escape close", "return focus", "background inert"]
    }
  },
